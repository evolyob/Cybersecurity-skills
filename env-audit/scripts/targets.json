  "system_guards": [
    {
      "id": "sip",
      "name": "System Integrity Protection (SIP)",
      "category": "Core Defense",
      "cmd": [
        "csrutil",
        "status"
      ],
      "expect": "enabled",
      "platform": [
        "macos"
      ]
    },
    {
      "id": "gatekeeper",
      "name": "Gatekeeper Assessment",
      "category": "Core Defense",
      "cmd": [
        "spctl",
        "--status"
      ],
      "expect": "assessments enabled",
      "platform": [
        "macos"
      ]
    },
    {
      "id": "alf",
      "name": "Application Layer Firewall (ALF)",
      "category": "Core Defense",
      "cmd": [
        "/usr/libexec/ApplicationFirewall/socketfilterfw",
        "--getglobalstate"
      ],
      "expect": "State = 1",
      "platform": [
        "macos"
      ]
    },
    {
      "id": "airplay",
      "name": "AirPlay Receiver Broadcast",
      "category": "Attack Surface",
      "cmd": [
        "defaults",
        "-currentHost",
        "read",
        "com.apple.controlcenter",
        "AirplayRecieverEnabled"
      ],
      "expect": "0",
      "platform": [
        "macos"
      ]
    }
  ]
